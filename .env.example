# Aanvraagformulier → Twenty (Instellingen → API & Webhooks → API-sleutel)
TWENTY_API_URL=https://jouw-twenty-adres
TWENTY_API_KEY=

# Mail: melding van een nieuwe aanvraag en bevestiging aan de aanvrager (bijvoorbeeld Zoho: smtp.zoho.eu, poort 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=clement@peleman.io
AANVRAAG_NAAR=clement@peleman.io

# Meting, alleen na toestemming. Leeg laten = geen cookiebanner en geen meting.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
